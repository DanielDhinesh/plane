# Compose-level variables for deployments/aws/docker-compose.aws.yml
# Copy to deployments/aws/.env on the server. Never commit the real file.

# --- Images (Amazon ECR) ------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
# Use an immutable tag per release (git SHA), never "latest" in production.
IMAGE_TAG=replace-with-git-sha

# --- Proxy / TLS ---------------------------------------------------------------
# With an Application Load Balancer + ACM certificate (recommended): keep :80.
# Without an ALB: set your domain (e.g. app.example.com) and CERT_EMAIL for Let's Encrypt.
SITE_ADDRESS=:80
CERT_EMAIL=
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
TRUSTED_PROXIES=private_ranges

# Must match AWS_S3_BUCKET_NAME / FILE_SIZE_LIMIT in env/api.env
AWS_S3_BUCKET_NAME=velora-prod-uploads
FILE_SIZE_LIMIT=104857600

# --- Logging -------------------------------------------------------------------
LOG_GROUP=/velora/production

# --- Only for the optional self-hosted broker (--profile rabbitmq) ---------------
RABBITMQ_USER=velora
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=velora
