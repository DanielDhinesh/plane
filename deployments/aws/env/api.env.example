# Runtime config for api / worker / beat-worker / migrator.
# Copy to deployments/aws/env/api.env on the server (chmod 600). Prefer pulling secrets
# from AWS Secrets Manager / SSM Parameter Store at deploy time (see scripts/fetch-secrets.sh).

# --- Core ----------------------------------------------------------------------
DEBUG=0
# 50+ random chars:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
APP_DOMAIN=app.example.com
WEB_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
# Public domain + internal names: "api" (used by the live server) and localhost (container health check).
ALLOWED_HOSTS=app.example.com,api,localhost,127.0.0.1
GUNICORN_WORKERS=3

APP_BASE_URL=https://app.example.com
APP_BASE_PATH=
ADMIN_BASE_URL=https://app.example.com
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=https://app.example.com
SPACE_BASE_PATH=/spaces
LIVE_BASE_URL=https://app.example.com
LIVE_BASE_PATH=/live
# Must be identical to LIVE_SERVER_SECRET_KEY in env/live.env
LIVE_SERVER_SECRET_KEY=

# --- PostgreSQL (Amazon RDS) ----------------------------------------------------
# Append ?sslmode=require to enforce TLS to RDS.
DATABASE_URL=postgresql://velora:CHANGE_ME@velora-prod.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/velora?sslmode=require

# --- Redis (Amazon ElastiCache, in-transit encryption on) ------------------------
REDIS_URL=rediss://master.velora-prod.xxxxxx.use1.cache.amazonaws.com:6379/0
REDIS_SSL_CERT_REQS=required

# --- Message broker (Amazon MQ for RabbitMQ — note amqps and port 5671) --------
AMQP_URL=amqps://velora:CHANGE_ME@b-xxxxxxxx.mq.us-east-1.amazonaws.com:5671/

# --- File storage (Amazon S3) ---------------------------------------------------
# Leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY *unset* (do not even write them empty):
# boto3 then uses the EC2 instance role, so no long-lived keys exist on the server.
USE_MINIO=0
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=velora-prod-uploads
FILE_SIZE_LIMIT=104857600
SIGNED_URL_EXPIRATION=3600

# --- Security / limits ----------------------------------------------------------
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
HARD_DELETE_AFTER_DAYS=60

# --- Billing (Stripe) -----------------------------------------------------------
# Live keys from https://dashboard.stripe.com/apikeys ; webhook secret from the webhook endpoint
# pointing at https://app.example.com/api/billing/webhooks/stripe/
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
STRIPE_PRICE_ENTERPRISE_MONTH=
STRIPE_PRICE_ENTERPRISE_YEAR=
BILLING_TRIAL_DAYS=14
# Never enable in production — lets admins change plans without paying.
BILLING_DEV_MODE=0
