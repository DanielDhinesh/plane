# Runtime config for the real-time collaboration server (apps/live).
# Copy to deployments/aws/env/live.env on the server (chmod 600).

PORT=3000
# Internal address of the API inside the compose network
API_BASE_URL=http://api:8000
WEB_BASE_URL=https://app.example.com
LIVE_BASE_URL=https://app.example.com
LIVE_BASE_PATH=/live
CORS_ALLOWED_ORIGINS=https://app.example.com
# Must be identical to LIVE_SERVER_SECRET_KEY in env/api.env
LIVE_SERVER_SECRET_KEY=
REDIS_URL=rediss://master.velora-prod.xxxxxx.use1.cache.amazonaws.com:6379/0
