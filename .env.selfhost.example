# ---------------------------------------------------------------------------
# Stratify self-hosted configuration (used by docker-compose.selfhost.yml)
# Copy to .env.selfhost — or run `./stratify.sh setup` to generate secrets.
# ---------------------------------------------------------------------------

# Public address
APP_DOMAIN=localhost
WEB_URL=http://localhost
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
# Automatic HTTPS: set SITE_ADDRESS to your domain (e.g. pm.example.com) and
# CERT_EMAIL to "email you@example.com". Keep ":80" for plain HTTP behind another proxy.
SITE_ADDRESS=:80
CERT_EMAIL=

# Branding used in server-rendered emails
BRAND_NAME=Stratify

# Secrets — CHANGE ALL OF THESE (./stratify.sh setup generates random values)
SECRET_KEY=change-me-to-a-long-random-string
LIVE_SERVER_SECRET_KEY=change-me-too
POSTGRES_PASSWORD=change-me-db-password
RABBITMQ_PASSWORD=change-me-mq-password
STORAGE_SECRET_KEY=change-me-storage-secret

# Database / queue / storage
POSTGRES_USER=stratify
POSTGRES_DB=stratify
RABBITMQ_USER=stratify
RABBITMQ_VHOST=stratify
STORAGE_ACCESS_KEY=stratify
AWS_S3_BUCKET_NAME=uploads
# Use AWS S3 (or any S3) instead of the bundled storage: set USE_MINIO=0 and the endpoint/region.
USE_MINIO=1
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_REGION=
FILE_SIZE_LIMIT=5242880

# Default mail server for the whole instance (workspaces can override it in
# Settings -> Mail server; God mode -> Email can change it without a restart).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_FROM=Stratify <no-reply@example.com>

# Tuning
GUNICORN_WORKERS=2
API_KEY_RATE_LIMIT=60/minute
HARD_DELETE_AFTER_DAYS=60
STRATIFY_VERSION=local
